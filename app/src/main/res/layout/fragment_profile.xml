<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- HEADER — pinned -->
    <include
        android:id="@+id/header"
        layout="@layout/layout_app_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingBottom="100dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="32dp"
            android:paddingBottom="24dp">

            <!-- PROFILE PHOTO -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/profile_photo_bg"
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="9999dp"
                app:cardElevation="0dp"
                app:strokeWidth="4dp"
                app:strokeColor="#E6E2DB"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/iv_profile_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:padding="40dp"
                    android:src="@drawable/profile" />

            </com.google.android.material.card.MaterialCardView>

            <!-- PHOTO EDIT OVERLAY -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_change_photo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/theme_brown"
                app:strokeColor="#E6E2DB"
                app:strokeWidth="2dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/profile_photo_bg"
                app:layout_constraintBottom_toBottomOf="@id/profile_photo_bg"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/white" />

            </com.google.android.material.card.MaterialCardView>

            <!-- NAME -->
            <TextView
                android:id="@+id/tv_profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/playfairdisplay_bold"
                android:text="User"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/profile_photo_bg" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_edit_underline"
                android:fontFamily="@font/playfairdisplay_bold"
                android:gravity="center"
                android:hint="Name"
                android:inputType="textPersonName"
                android:paddingHorizontal="8dp"
                android:text="User"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="28sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/profile_photo_bg"
                tools:visibility="visible" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tag_badge_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="80dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#ECE7E1"
                app:strokeColor="#DBC2B0"
                app:strokeWidth="1dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/profile_photo_bg">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:id="@+id/iv_tag_icon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_leaf"
                        app:tint="@color/theme_green_badge" />

                    <TextView
                        android:id="@+id/tv_tag_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/manrope_bold"
                        android:text="Naturalist"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PERSONAL DETAILS SECTION -->
            <TextView
                android:id="@+id/tv_details_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="@font/playfairdisplay_bold"
                android:text="Personal Details"
                android:textColor="@color/theme_brown"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_edit_details"
                app:layout_constraintTop_toBottomOf="@id/tag_badge_bg" />

            <!-- EDIT (PENCIL) BUTTON — visible in display mode -->
            <ImageButton
                android:id="@+id/btn_edit_details"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_edit_pencil"
                app:tint="@color/theme_brown"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_details_title"
                app:layout_constraintBottom_toBottomOf="@id/tv_details_title" />

            <!-- SAVE (CHECK) BUTTON — visible in edit mode, hidden by default -->
            <ImageButton
                android:id="@+id/btn_save_details"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                android:scaleType="fitCenter"
                app:tint="@color/theme_brown"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_details_title"
                app:layout_constraintBottom_toBottomOf="@id/tv_details_title" />

            <View
                android:id="@+id/details_divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="@color/divider_light"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_details_title" />

            <!-- EMAIL ROW -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/icon_bg_email"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_cream"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/details_divider">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mail"
                    app:tint="@color/theme_brown" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_email_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFamily="@font/manrope_bold"
                android:text="Email"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@id/icon_bg_email"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/icon_bg_email" />

            <TextView
                android:id="@+id/tv_email_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/manrope_regular"
                android:text="elena.botanist@herbarium.co"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                app:layout_constraintStart_toEndOf="@id/icon_bg_email"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_email_label" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_email_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_edit_underline"
                android:fontFamily="@font/manrope_regular"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:padding="0dp"
                android:text="elena.botanist@herbarium.co"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp"
                android:visibility="gone"
                app:layout_constraintStart_toEndOf="@id/icon_bg_email"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_email_label"
                tools:visibility="visible" />

            <!-- PHONE ROW -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/icon_bg_phone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="28dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_cream"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/icon_bg_email">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_phone"
                    app:tint="@color/theme_brown" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_phone_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFamily="@font/manrope_bold"
                android:text="Phone"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@id/icon_bg_phone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/icon_bg_phone" />

            <TextView
                android:id="@+id/tv_phone_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/manrope_regular"
                android:text="+1 234 567 8900"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                app:layout_constraintStart_toEndOf="@id/icon_bg_phone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_phone_label" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_phone_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_edit_underline"
                android:fontFamily="@font/manrope_regular"
                android:hint="Phone"
                android:inputType="phone"
                android:padding="0dp"
                android:text="+1 234 567 8900"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp"
                android:visibility="gone"
                app:layout_constraintStart_toEndOf="@id/icon_bg_phone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_phone_label"
                tools:visibility="visible" />

            <!-- HOME ADDRESS ROW -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/icon_bg_address"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="28dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_cream"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/icon_bg_phone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintVertical_bias="0">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_pin"
                    app:tint="@color/theme_brown" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_address_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFamily="@font/manrope_bold"
                android:text="Home Address"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@id/icon_bg_address"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/icon_bg_address" />

            <TextView
                android:id="@+id/tv_address_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/manrope_regular"
                android:text="123 Willow Lane, Bloomsville"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                app:layout_constraintStart_toEndOf="@id/icon_bg_address"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_address_label" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_address_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_edit_underline"
                android:fontFamily="@font/manrope_regular"
                android:hint="Home Address"
                android:inputType="textPostalAddress"
                android:padding="0dp"
                android:text="123 Willow Lane, Bloomsville"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp"
                android:visibility="gone"
                app:layout_constraintStart_toEndOf="@id/icon_bg_address"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_address_label"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>