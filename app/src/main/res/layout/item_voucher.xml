<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/voucher_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/card_cream"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider_light">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="16dp"
        android:paddingHorizontal="20dp">

        <ImageView
            android:id="@+id/iv_voucher_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_voucher"
            app:tint="@color/theme_brown"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tv_voucher_code"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:fontFamily="@font/manrope_bold"
            android:text="WELCOME20"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@id/iv_voucher_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_voucher_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/manrope_medium"
            android:text="20.000đ off your order!"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@id/tv_voucher_code"
            app:layout_constraintTop_toBottomOf="@id/tv_voucher_code"
            app:layout_constraintEnd_toStartOf="@id/rb_voucher_select"
            android:layout_marginEnd="16dp"
            android:maxLines="2"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tv_voucher_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/manrope_bold"
            android:text="Min Spend: 50.000đ"
            android:textColor="@color/theme_maroon"
            android:textSize="11sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/tv_voucher_code"
            app:layout_constraintTop_toBottomOf="@id/tv_voucher_desc"
            app:layout_constraintEnd_toStartOf="@id/rb_voucher_select"
            tools:visibility="visible" />

        <RadioButton
            android:id="@+id/rb_voucher_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:buttonTint="@color/text_secondary"
            android:button="@drawable/radio_button_selector"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
