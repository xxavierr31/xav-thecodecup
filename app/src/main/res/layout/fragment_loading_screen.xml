<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_loading_gradient">
    <TextView
        android:id="@+id/app_title_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/app_title_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fontFamily="@font/playfairdisplay_medium"
        android:text="THE"
        android:textSize="35sp"
        android:textColor="@color/theme_brown"/>
    <TextView
        android:id="@+id/app_title_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.3"
        android:letterSpacing="0.11"
        android:text="CODE CUP"
        android:textAlignment="center"
        android:fontFamily="@font/playfairdisplay_bold"
        android:textSize="48sp"
        android:textColor="@color/theme_dark_brown"/>
    <View
        android:layout_width="100dp"
        android:layout_height="3dp"
        android:background="@color/theme_brown"
        app:layout_constraintTop_toBottomOf="@id/app_title_2"
        app:layout_constraintBottom_toTopOf="@id/flower"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ImageView
        android:id="@+id/flower"
        android:layout_width="150dp"
        android:layout_height="150dp"
        app:tint="@color/theme_dark_brown"
        android:src="@drawable/ic_logo"
        app:layout_constraintTop_toBottomOf="@id/app_title_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.2"/>
</androidx.constraintlayout.widget.ConstraintLayout>