<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- HEADER — pinned -->
    <include
        android:id="@+id/header"
        layout="@layout/layout_app_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- TITLE -->
            <TextView
                android:id="@+id/tv_product_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/playfairdisplay_bold"
                android:text="Classic Latte"
                android:textColor="@color/theme_brown"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_product_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/manrope_regular"
                android:text="Smooth espresso softened with steamed milk."
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:textAlignment="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_product_title" />

            <!-- ILLUSTRATION PLACEHOLDER -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/product_image_card"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintWidth_max="240dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_product_subtitle">

                <ImageView
                    android:id="@+id/iv_product_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/drinks_dark_espresso" />

            </com.google.android.material.card.MaterialCardView>

            <!-- SWEETNESS -->
            <TextView
                android:id="@+id/tv_sweetness_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="@font/manrope_bold"
                android:text="Sweetness"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tv_sweetness_value"
                app:layout_constraintTop_toBottomOf="@id/product_image_card" />

            <TextView
                android:id="@+id/tv_sweetness_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_bold"
                android:text="50%"
                android:textColor="@color/theme_brown"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_sweetness_label" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_sweetness"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:stepSize="25"
                android:value="50"
                android:valueFrom="0"
                android:valueTo="100"
                app:labelBehavior="gone"
                app:thumbColor="@color/theme_brown"
                app:trackColorActive="@color/theme_brown"
                app:trackColorInactive="@color/divider_light"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_sweetness_label" />

            <TextView
                android:id="@+id/tv_sweetness_scale_none"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_regular"
                android:text="0%"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="@id/slider_sweetness"
                app:layout_constraintTop_toBottomOf="@id/slider_sweetness" />

            <TextView
                android:id="@+id/tv_sweetness_scale_25"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_regular"
                android:text="25%"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.25"
                app:layout_constraintTop_toBottomOf="@id/slider_sweetness" />

            <TextView
                android:id="@+id/tv_sweetness_scale_50"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_regular"
                android:text="50%"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintTop_toBottomOf="@id/slider_sweetness" />

            <TextView
                android:id="@+id/tv_sweetness_scale_75"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_regular"
                android:text="75%"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.75"
                app:layout_constraintTop_toBottomOf="@id/slider_sweetness" />

            <TextView
                android:id="@+id/tv_sweetness_scale_full"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_regular"
                android:text="100%"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="@id/slider_sweetness"
                app:layout_constraintTop_toBottomOf="@id/slider_sweetness" />

            <!-- TEMPERATURE -->
            <TextView
                android:id="@+id/tv_temperature_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/manrope_bold"
                android:text="Temperature"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_sweetness_scale_none" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/temperature_toggle_bg"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#80E6E2DB"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_temperature_label">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_temp_iced"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Iced"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:fontFamily="@font/manrope_bold"
                        app:cornerRadius="12dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btn_temp_hot"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_temp_hot"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Hot"
                        android:textAllCaps="false"
                        android:textColor="@color/theme_brown"
                        android:textSize="14sp"
                        app:backgroundTint="@color/card_cream"
                        android:fontFamily="@font/manrope_bold"
                        app:cornerRadius="12dp"
                        app:layout_constraintStart_toEndOf="@id/btn_temp_iced"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TEMPERATURE LEVEL -->
            <TextView
                android:id="@+id/tv_temp_level_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/manrope_medium"
                android:text="Ice Level"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tv_temp_level_value"
                app:layout_constraintTop_toBottomOf="@id/temperature_toggle_bg" />

            <TextView
                android:id="@+id/tv_temp_level_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_bold"
                android:text="50%"
                android:textColor="@color/theme_brown"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_temp_level_label" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_temp_level"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:stepSize="25"
                android:value="50"
                android:valueFrom="0"
                android:valueTo="100"
                app:labelBehavior="gone"
                app:thumbColor="@color/theme_brown"
                app:trackColorActive="@color/theme_brown"
                app:trackColorInactive="@color/divider_light"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_temp_level_label" />

            <TextView
                android:id="@+id/tv_temp_level_scale_none"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_regular"
                android:text="0%"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="@id/slider_temp_level"
                app:layout_constraintTop_toBottomOf="@id/slider_temp_level" />

            <TextView
                android:id="@+id/tv_temp_level_scale_25"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_regular"
                android:text="25%"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.25"
                app:layout_constraintTop_toBottomOf="@id/slider_temp_level" />

            <TextView
                android:id="@+id/tv_temp_level_scale_50"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_regular"
                android:text="50%"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintTop_toBottomOf="@id/slider_temp_level" />

            <TextView
                android:id="@+id/tv_temp_level_scale_75"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_regular"
                android:text="75%"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.75"
                app:layout_constraintTop_toBottomOf="@id/slider_temp_level" />

            <TextView
                android:id="@+id/tv_temp_level_scale_full"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_regular"
                android:text="100%"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="@id/slider_temp_level"
                app:layout_constraintTop_toBottomOf="@id/slider_temp_level" />

            <!-- ESPRESSO SHOTS -->
            <TextView
                android:id="@+id/tv_shots_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/manrope_bold"
                android:text="Extra Shots"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_temp_level_scale_none"
                app:layout_constraintBottom_toBottomOf="@id/shots_stepper_bg" />

            <TextView
                android:id="@+id/tv_shots_guide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_medium"
                android:text="(Max 4 shots, each +7.000đ)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_shots_label"
                android:layout_marginTop="2dp"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/shots_stepper_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#80E6E2DB"
                app:contentPadding="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_temp_level_scale_none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btn_shots_minus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_minus"
                        app:tint="@color/text_primary" />

                    <TextView
                        android:id="@+id/tv_shots_count"
                        android:layout_width="28dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_bold"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/btn_shots_plus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/text_primary" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ADD FLAVOR -->
            <TextView
                android:id="@+id/tv_flavor_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/manrope_bold"
                android:text="Add Flavored Syrup"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/shots_stepper_bg" />

            <CheckBox
                android:id="@+id/cb_vanilla"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:buttonTint="@color/theme_brown"
                android:fontFamily="@font/manrope_regular"
                android:text="Vanilla (+ 5.000d)"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_flavor_label" />

            <CheckBox
                android:id="@+id/cb_hazelnut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:buttonTint="@color/theme_brown"
                android:fontFamily="@font/manrope_regular"
                android:text="Hazelnut (+ 5.000d)"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cb_vanilla" />

            <CheckBox
                android:id="@+id/cb_caramel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:buttonTint="@color/theme_brown"
                android:fontFamily="@font/manrope_regular"
                android:text="Caramel (+ 5.000d)"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cb_hazelnut"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM BAR — pinned, stays fixed -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/customize_divider"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@color/divider_light"
            android:backgroundTint="@color/divider_light"
            app:layout_constraintTop_toTopOf="@id/bottom_bar"
            app:layout_constraintStart_toStartOf="@id/bottom_bar"/>
        <TextView
            android:id="@+id/tv_total_price_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope_regular"
            android:text="Total Price"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/customize_divider" />

        <TextView
            android:id="@+id/tv_total_price_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginHorizontal="20dp"
            android:fontFamily="@font/playfairdisplay_bold"
            android:text="100.000d"
            android:textColor="@color/theme_brown"
            android:textSize="24sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_total_price_label"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_to_cart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="Add to Cart"
            android:textAllCaps="false"
            android:fontFamily="@font/manrope_bold"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:backgroundTint="@color/theme_brown"
            app:cornerRadius="24dp"
            app:icon="@drawable/bag"
            app:iconTint="@color/white"
            app:iconGravity="textStart"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/customize_divider"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>