<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loadingScreenFragment">

    <fragment
        android:id="@+id/loadingScreenFragment"
        android:name="com.example.personalmidterm.ui.loading.LoadingScreenFragment"
        android:label="Loading"
        tools:layout="@layout/fragment_loading_screen">
        <action
            android:id="@+id/action_loadingScreenFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loadingScreenFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.personalmidterm.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_detailsFragment"
            app:destination="@id/detailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/menuFragment"
        android:name="com.example.personalmidterm.ui.menu.MenuFragment"
        android:label="Menu"
        tools:layout="@layout/fragment_menu">
        <action
            android:id="@+id/action_menuFragment_to_detailsFragment"
            app:destination="@id/detailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/rewardsFragment"
        android:name="com.example.personalmidterm.ui.rewards.RewardsFragment"
        android:label="Rewards"
        tools:layout="@layout/fragment_rewards">
        <action
            android:id="@+id/action_rewardsFragment_to_redeemFragment"
            app:destination="@id/redeemFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.personalmidterm.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/myOrdersFragment"
        android:name="com.example.personalmidterm.ui.myorders.MyOrdersFragment"
        android:label="My Orders"
        tools:layout="@layout/fragment_orders" />

    <fragment
        android:id="@+id/detailsFragment"
        android:name="com.example.personalmidterm.ui.details.DetailsFragment"
        android:label="Details"
        tools:layout="@layout/fragment_customize">
        <argument
            android:name="coffeeId"
            app:argType="long" />
        <argument
            android:name="customization"
            app:argType="com.example.personalmidterm.model.Customization"
            app:nullable="true"
            android:defaultValue="@null" />
        <action
            android:id="@+id/action_detailsFragment_to_cartFragment"
            app:destination="@id/cartFragment" />
    </fragment>

    <fragment
        android:id="@+id/cartFragment"
        android:name="com.example.personalmidterm.ui.cart.CartFragment"
        android:label="Cart"
        tools:layout="@layout/fragment_cart">
        <action
            android:id="@+id/action_cartFragment_to_orderSuccessFragment"
            app:destination="@id/orderSuccessFragment" />
        <action
            android:id="@+id/action_cartFragment_to_voucherFragment"
            app:destination="@id/voucherFragment" />
    </fragment>

    <fragment
        android:id="@+id/voucherFragment"
        android:name="com.example.personalmidterm.ui.cart.VoucherFragment"
        android:label="Vouchers"
        tools:layout="@layout/fragment_vouchers" />

    <fragment
        android:id="@+id/orderSuccessFragment"
        android:name="com.example.personalmidterm.ui.ordersuccess.OrderSuccessFragment"
        android:label="Order Success"
        tools:layout="@layout/fragment_order_confirmed">
        <action
            android:id="@+id/action_orderSuccessFragment_to_myOrdersFragment"
            app:destination="@id/myOrdersFragment"
            app:popUpTo="@id/homeFragment" />
        <action
            android:id="@+id/action_orderSuccessFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/redeemFragment"
        android:name="com.example.personalmidterm.ui.redeem.RedeemFragment"
        android:label="Redeem"
        tools:layout="@layout/fragment_redeem" />

</navigation>